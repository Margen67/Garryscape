{
    "runtime.version": "LuaJIT",
    "runtime.nonstandardSymbol": ["!", "!=", "&&", "||", "//", "/**/", "continue"],
    "diagnostics.groupFileStatus": {
        "unused": "Any",
        "unbalanced": "Any",
        "type-check": "Any",
        "luadoc": "Any",
        "codestyle": "Any",
        "ambiguity": "Any",
        "await": "Any",
        "strong": "Any",
        "redefined": "Any",
        "global": "Any",
        "conventions": "Any",
        "duplicate": "Any",
        "strict": "Any"
    },
    "diagnostics.disable": ["codestyle-check"],
    "diagnostics.globals": [
        "EGSM",
        "shaderlib",
        "PARAM_BASETEXTURE",
        "SHADER_PARAM_TYPE_VEC4",
        "PSREG_LIGHT_INFO_ARRAY",
        "STDCONST_LIGHT_INFO",
        "PSREG_FOG_PARAMS",
        "STDCONST_FOG_PARAMS",
        "PSREG_DIFFUSE_MODULATION",
        "STDCONST_DIFFUSE_MODULATION",
        "PSREG_AMBIENT_CUBE",
        "STDCONST_AMBIENT_CUBE",
        "PSREG_SHADER_CONTROLS",
        "STDCONST_SHADER_CONTROLS",
        "PSREG_EYEPOS_SPEC_EXPONENT",
        "STDCONST_EYE_POS"
    ],
    "workspace.ignoreDir": ["output", "converter/target"]
}
