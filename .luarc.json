{
    "runtime.version": "LuaJIT",
    "type.castNumberToInteger": false,
    "type.inferParamType": true,
    "type.checkTableShape": true,
    "runtime.nonstandardSymbol": ["!", "!=", "&&", "||", "//", "/**/", "continue"],
    "diagnostics.groupFileStatus": {
        "unused": "Any",
        "unbalanced": "Any",
        "type-check": "Any",
        "luadoc": "Any",
        "codestyle": "Any",
        "ambiguity": "Any",
        "await": "Any",
        "strong": "Any",
        "redefined": "Any",
        "global": "Any",
        "conventions": "Any",
        "duplicate": "Any",
        "strict": "Any"
    },
    "diagnostics.severity": {
        "unused-local": "Warning",
        "unused-function": "Warning",
        "unused-label": "Warning",
        "unused-vararg": "Warning",
        "trailing-space": "Warning",
        "redundant-return": "Warning",
        "empty-block": "Warning",
        "code-after-break": "Warning",
        "unreachable-code": "Warning",
        "redefined-local": "Warning",
        "spell-check": "Warning",
        "lowercase-global": "Warning",
        "undefined-env-child": "Warning"
    },
    "diagnostics.globals": [
        "EGSM",
        "shaderlib",
        "PARAM_BASETEXTURE",
        "SHADER_PARAM_TYPE_VEC4",
        "PSREG_LIGHT_INFO_ARRAY",
        "STDCONST_LIGHT_INFO",
        "PSREG_FOG_PARAMS",
        "STDCONST_FOG_PARAMS",
        "PSREG_DIFFUSE_MODULATION",
        "STDCONST_DIFFUSE_MODULATION",
        "PSREG_AMBIENT_CUBE",
        "STDCONST_AMBIENT_CUBE",
        "PSREG_SHADER_CONTROLS",
        "STDCONST_SHADER_CONTROLS",
        "PSREG_EYEPOS_SPEC_EXPONENT",
        "STDCONST_EYE_POS"
    ],
    "workspace.ignoreDir": ["output", "converter/target"]
}
